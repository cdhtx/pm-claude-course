{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/pm-claude-code-guide", "dest": "/pm-claude-code-guide.html" },
    { "src": "/pm-claude-code-guide.html", "dest": "/pm-claude-code-guide.html" }
  ]
}
